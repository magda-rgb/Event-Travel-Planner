# Copy to `.env` and fill in real values. `.env` is gitignored.

# --- MongoDB ---------------------------------------------------------------
# Local default works if you have MongoDB running on localhost:27017.
MONGO_URI=mongodb://localhost:27017
MONGO_DB=projekt_db

# --- Ticketmaster ----------------------------------------------------------
# Free key: https://developer.ticketmaster.com/  (sign up, create an app,
# copy the "Consumer Key").
TICKETMASTER_API_KEY=

# --- Google Maps ------------------------------------------------------------
# https://console.cloud.google.com/  (create project, enable Directions API,
# create credentials -> API key, restrict to Directions API).
# Wymagana karta + billing, ale Maps Platform daje $200/mies darmowego kredytu.
GOOGLE_MAPS_API_KEY=
