# Copy to `.env` and fill in real values. `.env` is gitignored.

# --- MongoDB ---------------------------------------------------------------
# Local default works if you have MongoDB running on localhost:27017.
MONGO_URI=mongodb://localhost:27017
MONGO_DB=projekt_db

